# Copy this file to .env and fill in the server values for your environment.

# Build server WebSocket endpoint.
WS_SERVER=ws://<server-ip>:<port>

# Host used by the build server to fetch course data.
WS_HOST=<server-ip>:<port>

# Read-only SVN base URLs returned by /api/publish-config.
# Leave these as placeholders and inject real deployment values through the
# server environment; never commit credentials or certificates.
SVN_BASE_NORMAL=svn://<svn-host>/product/trunk/course/Math
SVN_BASE_HOMEWORK=svn://<svn-host>/product/trunk/course/Math
SVN_BASE_EVALUATION=svn://<svn-host>/product/trunk/course/Math/SPECIAL_EVALUATION/YZ
SVN_BASE_REVIEW=svn://<svn-host>/product/trunk/course/Math/REVIEW/YZ

# Optional development-only overrides. The packaged Windows client uses its
# bundled SVN CLI and locates TortoiseSVN separately.
# FORGE_SVN_BINARY=<absolute-path-to-svn>
# FORGE_TORTOISE_PROC=<absolute-path-to-TortoiseProc.exe>
